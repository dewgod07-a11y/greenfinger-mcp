# ────────────────────────────────────────────
# 그린핑거 MCP 서버 환경변수 설정 파일
# 이 파일을 복사해서 .env 로 저장 후 값을 채우세요
# cp .env.example .env
# ────────────────────────────────────────────

# 1. Anthropic Claude API 키 (병해충 진단·정원 설계 AI)
#    → https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=여기에_Anthropic_API키_입력

# 2. 서버 설정 (클라우드 배포 시)
HOST=0.0.0.0
PORT=8000
DEBUG=false
